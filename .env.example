# Database Configuration
# NOTE: Check if your local MySQL runs on port 3306 or 3307 (MySQL 8.0 commonly uses 3307)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=student_progression

# Flask Security
FLASK_SECRET_KEY=student-progression-secure-demo-key-2026

# Google Sheets One-Way Synchronization (Optional)
# Leave empty if not yet configured - the application will run smoothly without it.
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS=credentials/service_account.json
